# ==============================================================================
# .gitignore - NBA Predictor Quantitative Pipeline
# ==============================================================================

# --- Entornos virtuales y dependencias ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Caché y compilados de Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Pruebas, Cobertura y Linter ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Secretos y Configuración Privada ---
.env
*.env
.env.*
config.yaml

# --- Bases de Datos y Almacenamiento Local ---
*.db
*.sqlite
*.sqlite3
nba_predictor.db

# --- Hojas de Cálculo y Seguimiento de Apuestas ---
*.xlsx
*.xls
*.csv

# --- Datasets Pesados y Modelos Binarios Compilados ---
*.parquet
*.joblib
*.pkl
xgboost_model.json
data/
models/*.joblib

# --- IDEs y Editores de Código ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- Carpetas Temporales y Agentes de IA ---
.gemini/
scratch/
.gga
*.log
